{
  "name": "claude-switch",
  "displayName": "Claude API Switch",
  "description": "Manage & switch Claude Code API endpoints from the sidebar. Test connectivity, track usage, one-click apply.",
  "version": "1.2.0",
  "publisher": "claude-switch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/canichols2-pnnl/pnnl-claude-switch-poc"
  },
  "bugs": {
    "url": "https://github.com/canichols2-pnnl/pnnl-claude-switch-poc/issues"
  },
  "homepage": "https://github.com/canichols2-pnnl/pnnl-claude-switch-poc#readme",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "api",
    "switch",
    "deepseek",
    "qwen",
    "endpoint",
    "profile",
    "environment",
    "cursor"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:claudeSwitch.profilesView"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSwitchSidebar",
          "title": "Claude API Switch",
          "icon": "$(server-environment)"
        }
      ]
    },
    "views": {
      "claudeSwitchSidebar": [
        {
          "id": "claudeSwitch.profilesView",
          "name": "API Profiles"
        }
      ]
    },
    "configuration": {
      "title": "Claude API Switch",
      "properties": {
        "claudeSwitch.storageTarget": {
          "type": "string",
          "enum": [
            "user",
            "workspace"
          ],
          "default": "user",
          "scope": "application",
          "enumDescriptions": [
            "Write the applied profile to `claudeCode.environmentVariables` in user settings.json (shared by every VS Code window).",
            "Write the applied profile to the `env` block of `.claude/settings.local.json` in each workspace folder, so each window can use a different profile. Switching to this removes `claudeCode.environmentVariables` from user settings."
          ],
          "markdownDescription": "Where **Apply Profile** / **Quick Switch** save the profile's environment variables.\n\n- `user` — `claudeCode.environmentVariables` in user settings (one profile for all windows).\n- `workspace` — `env` in `<folder>/.claude/settings.local.json`, read by Claude Code per project. The file is added to `.git/info/exclude` so keys are not committed, and `claudeCode.environmentVariables` is removed from user settings."
        },
        "claudeSwitch.statusRefreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "How often (in seconds) the status bar re-checks the settings file against your saved profiles, to catch changes made outside this window. File-change, settings-change and window-focus events always trigger a check; this is a backstop. `0` disables polling (minimum 5 when enabled)."
        }
      }
    },
    "commands": [
      {
        "command": "claudeSwitch.addProfile",
        "title": "Add API Profile",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitch.editProfile",
        "title": "Edit Profile",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSwitch.deleteProfile",
        "title": "Delete Profile",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSwitch.applyProfile",
        "title": "Apply Profile",
        "icon": "$(check)"
      },
      {
        "command": "claudeSwitch.duplicateProfile",
        "title": "Duplicate Profile",
        "icon": "$(copy)"
      },
      {
        "command": "claudeSwitch.exportProfile",
        "title": "Export Profile as JSON",
        "icon": "$(export)"
      },
      {
        "command": "claudeSwitch.importProfile",
        "title": "Import Profile from JSON",
        "icon": "$(import)"
      },
      {
        "command": "claudeSwitch.exportAll",
        "title": "Export All Profiles",
        "icon": "$(save-all)"
      },
      {
        "command": "claudeSwitch.importAll",
        "title": "Import Profiles from JSON",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeSwitch.importFromCurrent",
        "title": "Import Profile from Current Settings",
        "icon": "$(arrow-down)"
      },
      {
        "command": "claudeSwitch.editAsJson",
        "title": "Edit Profile as JSON",
        "icon": "$(json)"
      },
      {
        "command": "claudeSwitch.testProfile",
        "title": "Test API Connection",
        "icon": "$(debug-start)"
      },
      {
        "command": "claudeSwitch.quickSwitch",
        "title": "Quick Switch Profile",
        "icon": "$(replace-all)"
      },
      {
        "command": "claudeSwitch.selectStorageTarget",
        "title": "Choose Where Profiles Are Saved (User / Workspace)",
        "icon": "$(gear)"
      },
      {
        "command": "claudeSwitch.clearUsageStats",
        "title": "Clear Usage Statistics",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeSwitch.refreshProfiles",
        "title": "Refresh Profiles",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSwitch.viewCurrentConfig",
        "title": "View Current Config",
        "icon": "$(eye)"
      },
      {
        "command": "claudeSwitch.debugTestProfile",
        "title": "Debug: Create Test Profile",
        "icon": "$(debug)"
      },
      {
        "command": "claudeSwitch.debugShowState",
        "title": "Debug: Show Extension State",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSwitch.addProfile",
          "when": "view == claudeSwitch.profilesView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitch.importFromCurrent",
          "when": "view == claudeSwitch.profilesView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitch.quickSwitch",
          "when": "view == claudeSwitch.profilesView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitch.refreshProfiles",
          "when": "view == claudeSwitch.profilesView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitch.exportAll",
          "when": "view == claudeSwitch.profilesView",
          "group": "export@1"
        },
        {
          "command": "claudeSwitch.importProfile",
          "when": "view == claudeSwitch.profilesView",
          "group": "import@1"
        },
        {
          "command": "claudeSwitch.importAll",
          "when": "view == claudeSwitch.profilesView",
          "group": "import@2"
        },
        {
          "command": "claudeSwitch.selectStorageTarget",
          "when": "view == claudeSwitch.profilesView",
          "group": "settings@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSwitch.applyProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "claudeSwitch.testProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "claudeSwitch.editProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "claudeSwitch.editAsJson",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "context@1"
        },
        {
          "command": "claudeSwitch.duplicateProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "context@2"
        },
        {
          "command": "claudeSwitch.exportProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "context@3"
        },
        {
          "command": "claudeSwitch.deleteProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "context@4"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
