{
  "name": "pnnl-claude-switch",
  "displayName": "PNNL Claude API Switch",
  "description": "Per-workspace Claude Code API profiles for PNNL developers — AI Incubator templates, connectivity tests, one-click switching.",
  "version": "1.2.0",
  "publisher": "claude-switch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/canichols2-pnnl/pnnl-claude-switch-poc"
  },
  "bugs": {
    "url": "https://github.com/canichols2-pnnl/pnnl-claude-switch-poc/issues"
  },
  "homepage": "https://github.com/canichols2-pnnl/pnnl-claude-switch-poc#readme",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "pnnl",
    "ai-incubator",
    "litellm",
    "api",
    "switch",
    "profile",
    "workspace",
    "environment"
  ],
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:claudeSwitch.profilesView"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeSwitchSidebar",
          "title": "PNNL Claude API Switch",
          "icon": "$(server-environment)"
        }
      ]
    },
    "views": {
      "claudeSwitchSidebar": [
        {
          "id": "claudeSwitch.profilesView",
          "name": "API Profiles"
        }
      ]
    },
    "configuration": {
      "title": "PNNL Claude API Switch",
      "properties": {
        "claudeSwitch.storageTarget": {
          "type": "string",
          "enum": [
            "workspace",
            "user"
          ],
          "default": "workspace",
          "scope": "application",
          "enumDescriptions": [
            "Default. Write the applied profile to the `env` block of `.claude/settings.local.json` for this workspace (the file Claude Code reads for the first workspace folder), so every VS Code window can use its own key and models. Running Claude sessions pick up changed values. Removes `claudeCode.environmentVariables` from user settings.",
            "Write the applied profile to `claudeCode.environmentVariables` in user settings.json — one profile shared by every VS Code window; Claude sessions must be restarted to pick it up."
          ],
          "markdownDescription": "Where **Apply Profile** / **Quick Switch** save the profile's environment variables.\n\n- `workspace` *(default)* — `env` in `.claude/settings.local.json` for this workspace, so each project/window can use a different AI Incubator key. Added to `.git/info/exclude` so keys aren't committed; `claudeCode.environmentVariables` is removed from user settings.\n- `user` — `claudeCode.environmentVariables` in user settings (one profile for all windows)."
        },
        "claudeSwitch.statusRefreshIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "How often (in seconds) the status bar re-checks the settings file against your saved profiles, to catch changes made outside this window. File-change, settings-change and window-focus events always trigger a check; this is a backstop. `0` disables polling (minimum 5 when enabled)."
        }
      }
    },
    "commands": [
      {
        "command": "claudeSwitch.addProfile",
        "title": "Add API Profile",
        "icon": "$(add)"
      },
      {
        "command": "claudeSwitch.editProfile",
        "title": "Edit Profile",
        "icon": "$(edit)"
      },
      {
        "command": "claudeSwitch.deleteProfile",
        "title": "Delete Profile",
        "icon": "$(trash)"
      },
      {
        "command": "claudeSwitch.applyProfile",
        "title": "Apply Profile",
        "icon": "$(check)"
      },
      {
        "command": "claudeSwitch.duplicateProfile",
        "title": "Duplicate Profile",
        "icon": "$(copy)"
      },
      {
        "command": "claudeSwitch.exportProfile",
        "title": "Export Profile as JSON",
        "icon": "$(export)"
      },
      {
        "command": "claudeSwitch.importProfile",
        "title": "Import Profile from JSON",
        "icon": "$(import)"
      },
      {
        "command": "claudeSwitch.exportAll",
        "title": "Export All Profiles",
        "icon": "$(save-all)"
      },
      {
        "command": "claudeSwitch.importAll",
        "title": "Import Profiles from JSON",
        "icon": "$(folder-opened)"
      },
      {
        "command": "claudeSwitch.importFromCurrent",
        "title": "Import Profile from Current Settings",
        "icon": "$(arrow-down)"
      },
      {
        "command": "claudeSwitch.editAsJson",
        "title": "Edit Profile as JSON",
        "icon": "$(json)"
      },
      {
        "command": "claudeSwitch.testProfile",
        "title": "Test API Connection",
        "icon": "$(debug-start)"
      },
      {
        "command": "claudeSwitch.quickSwitch",
        "title": "Quick Switch Profile",
        "icon": "$(replace-all)"
      },
      {
        "command": "claudeSwitch.selectStorageTarget",
        "title": "Choose Where Profiles Are Saved (User / Workspace)",
        "icon": "$(gear)"
      },
      {
        "command": "claudeSwitch.clearUsageStats",
        "title": "Clear Usage Statistics",
        "icon": "$(clear-all)"
      },
      {
        "command": "claudeSwitch.refreshProfiles",
        "title": "Refresh Profiles",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeSwitch.viewCurrentConfig",
        "title": "View Current Config",
        "icon": "$(eye)"
      },
      {
        "command": "claudeSwitch.debugTestProfile",
        "title": "Debug: Create Test Profile",
        "icon": "$(debug)"
      },
      {
        "command": "claudeSwitch.debugShowState",
        "title": "Debug: Show Extension State",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSwitch.addProfile",
          "when": "view == claudeSwitch.profilesView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitch.importFromCurrent",
          "when": "view == claudeSwitch.profilesView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitch.quickSwitch",
          "when": "view == claudeSwitch.profilesView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitch.refreshProfiles",
          "when": "view == claudeSwitch.profilesView",
          "group": "navigation"
        },
        {
          "command": "claudeSwitch.exportAll",
          "when": "view == claudeSwitch.profilesView",
          "group": "export@1"
        },
        {
          "command": "claudeSwitch.importProfile",
          "when": "view == claudeSwitch.profilesView",
          "group": "import@1"
        },
        {
          "command": "claudeSwitch.importAll",
          "when": "view == claudeSwitch.profilesView",
          "group": "import@2"
        },
        {
          "command": "claudeSwitch.selectStorageTarget",
          "when": "view == claudeSwitch.profilesView",
          "group": "settings@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeSwitch.applyProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "claudeSwitch.testProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "claudeSwitch.editProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "claudeSwitch.editAsJson",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "context@1"
        },
        {
          "command": "claudeSwitch.duplicateProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "context@2"
        },
        {
          "command": "claudeSwitch.exportProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "context@3"
        },
        {
          "command": "claudeSwitch.deleteProfile",
          "when": "view == claudeSwitch.profilesView && viewItem == profile",
          "group": "context@4"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
